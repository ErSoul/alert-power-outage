### notify-server-up.sh ###

### TWILIO & TELESIGN (required)
### Account SID for Twilio / Customer ID for Telesign
# CUSTOMER_ID=
# API_KEY=
# URL=
# PHONE_TARGET=

### ONLY TWILIO
## The system phone number should be specified for Twilio
# PHONE_SRC=

### EMAIL (only with --email)
# SMTP_HOST=
# SMTP_PORT=

# FROM_ADDRESS=
# FROM_PASSWORD=
# TO_ADDRESS=

### notify-termux-plugged.sh ###

### NTFY.SH
# NTFY_TOPIC=

### EVOLUTION API (WHATSAPP)
# EVOLUTION_API_KEY=
# EVOLUTION_API_FQDN=
# EVOLUTION_API_INSTANCE=
# WS_PHONES=

### notify-network-plugged.sh ###
## This script does not source this file. Export these variables in the
## environment, or pass them through the matching command line options.
### NTFY.SH
# TOPIC=
### FILE TO READ PREVIOUS STATE
# STATE_FILE=
### OPTIONAL CSV HISTORY FILE
# OUTPUT_CSV_FILE=
### OPTIONAL LOCATION LABEL
# LOCATION=
